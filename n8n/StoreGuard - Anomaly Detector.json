      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        208,
        0
      ],
      "id": "f6297b11-d49b-4c96-96d2-7a72e089a5b7",
      "name": "get data from the store"
    },
    {
      "parameters": {
        "jsCode": "const products = $input.all().map(item => item.json);\n\nconst poorRated = products.filter(p => p.rating.rate < 2.5);\n\nif (poorRated.length === 0) return [];\n\nreturn [{\n  json: {\n    anomaly_type: \"poor_rating\",\n    severity: poorRated.some(p => p.rating.rate < 2.0) ? \"critical\" : \"warning\",\n    triggered_at: new Date().toISOString(),\n    affected_count: poorRated.length,\n    products: poorRated.map(p => ({\n      id: p.id,\n      title: p.title,\n      category: p.category,\n      price: p.price,\n      rating: p.rating.rate,\n      review_count: p.rating.count\n    }))\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        16
      ],
      "id": "0d1318dd-0934-4a47-b824-cde00637c4d6",
      "name": "check for poor_rating"
    },
    {
      "parameters": {
        "jsCode": "const products = $input.all().map(item => item.json);\n\n\nconst lowDemand = products.filter(p => p.rating.count < 150);\n\nif (lowDemand.length === 0) return [];\n\nreturn [{\n  json: {\n    anomaly_type: \"low_demand\",\n    severity: lowDemand.some(p => p.rating.count < 80) ? \"critical\" : \"warning\",\n    triggered_at: new Date().toISOString(),\n    affected_count: lowDemand.length,\n    products: lowDemand.map(p => ({\n      id: p.id,\n      title: p.title,\n      category: p.category,\n      price: p.price,\n      demand_count: p.rating.count\n    }))\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        176
      ],
      "id": "a40e3b4d-2e69-4778-84ac-e1652cc654ec",
      "name": "check for low_demand"
    },
    {
      "parameters": {
        "jsCode": "const products = $input.all().map(item => item.json);\n\n// Group by category\nconst categories = {};\nfor (const p of products) {\n  if (!categories[p.category]) categories[p.category] = [];\n  categories[p.category].push(p);\n}\n\n// Calculate avg per category and find outliers\nconst outliers = [];\nfor (const [cat, prods] of Object.entries(categories)) {\n  const avg = prods.reduce((sum, p) => sum + p.price, 0) / prods.length;\n  for (const p of prods) {\n    const deviation = Math.abs(p.price - avg) / avg;\n    if (deviation > 0.4) {\n      outliers.push({\n        id: p.id,\n        title: p.title,\n        category: cat,\n        price: p.price,\n        category_avg: Math.round(avg * 100) / 100,\n        deviation_pct: Math.round(deviation * 100)\n      });\n    }\n  }\n}\n\nif (outliers.length === 0) return [];\n\nreturn [{\n  json: {\n    anomaly_type: \"price_anomaly\",\n    severity: \"warning\",\n    triggered_at: new Date().toISOString(),\n    affected_count: outliers.length,\n    outliers\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        -160
      ],
      "id": "5a3844e7-4fbf-4181-8322-1e2b66e42c5d",
      "name": "check for price_anomaly"
    },
